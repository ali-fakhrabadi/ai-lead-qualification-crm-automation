# Copy to .env and adjust. Secrets never go here: they live in ./secrets (scripts/init-secrets.sh).

# Model: Ollama on another host (recommended on CPU-only machines), or the bundled profile
# (http://ollama:11434 with `docker compose --profile ollama up -d`).
LEAD_LLM_PROVIDER=ollama
LEAD_LLM_MODEL=llama3.1:8b
LEAD_OLLAMA_BASE_URL=http://host.docker.internal:11434
# LEAD_LLM_NUM_THREAD=8

# CRM: demo (bundled demo CRM), hubspot (set LEAD_CRM_BASE_URL=https://api.hubapi.com and put a
# private app token in secrets/crm_token), or none.
LEAD_CRM_PROVIDER=demo

# Where people open the web app (also used in operator notifications).
WEB_BIND=127.0.0.1
WEB_PORT=8080
LEAD_DASHBOARD_URL=http://localhost:8080
LEAD_OPERATOR_EMAIL=operators@northwind-automation.example

# n8n editor (published on loopback only) and the Mailpit web UI.
N8N_HTTP_PORT=5679
N8N_OWNER_EMAIL=owner@example.com
MAILPIT_UI_PORT=8025

# Optional package mirrors for image builds.
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org/
