    {
      "parameters": {
        "content": "## 5. Report\nThe outcome goes back to the API: completed, stopped on purpose (review needed, permanent error) or failed after retries (the event is delivered again later). Unexpected failures go to the error workflow.",
        "width": 520,
        "height": 200,
        "color": 7
      },
      "id": "e598dc13-ed8c-5bf2-bb4f-497bcf131a7f",
      "name": "Note: report",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        3740,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Code node \"Summarize run\" (run once for all items): what to report for this execution.\n//\n//   success   the pipeline ran to its end (a draft exists, or a delivery was made)\n//   stopped   the run ended on purpose: the lead needs review, or a permanent error needs\n//             an operator; the event is complete and is not delivered again\n//   error     a transient failure outlasted this run's retries; the API schedules another\n//             delivery of the event with backoff\nconst STAGES = [\"Plan draft retry\", \"Plan CRM retry\", \"Plan qualification retry\"]; // plan nodes, latest stage first\nconst VERIFY_NODE = 'Verify event';\n\nconst verified = $(VERIFY_NODE).first().json;\nlet last = null;\nfor (const name of STAGES) {\n  if ($(name).isExecuted) {\n    last = $(name).last().json;\n    break;\n  }\n}\n\nlet status;\nlet step;\nlet error = null;\nif (last === null) {\n  status = 'stopped';\n  step = 'next_step';\n} else {\n  step = last.step;\n  if (last.route === 'ok') {\n    status = last.next === 'done' ? 'success' : 'stopped';\n  } else if (last.route === 'permanent') {\n    status = 'stopped';\n    error = last.error;\n  } else {\n    status = 'error';\n    error = last.error;\n  }\n}\n\nreturn [\n  {\n    json: {\n      event_id: verified.event_id,\n      report: {\n        execution_id: String($execution.id),\n        status,\n        step,\n        duration_ms: Math.max(0, Date.now() - Number(verified.started_at || Date.now())),\n        error,\n      },\n    },\n  },\n];\n"
      },
      "id": "6b8d39e6-3a8d-52aa-815d-a0f04db88c62",
      "name": "Summarize run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3760,
        520
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.api_url }}/internal/v1/events/{{ $json.event_id }}/outcome",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.report) }}"
      },
      "id": "91f4828b-b7b5-5932-a54d-109ef43c092c",
      "name": "Report outcome",
