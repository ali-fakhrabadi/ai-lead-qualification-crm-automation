    {
      "parameters": {
        "content": "## 4. Follow-up draft and human approval\nA draft reply is generated and waits for a person to edit, approve or reject it. Nothing is sent here: n8n only notifies the operators' mailbox (the local Mailpit sink in the demo).",
        "width": 1100,
        "height": 200,
        "color": 7
      },
      "id": "e4dbcc4b-08ad-5910-9a53-788a2b66a96a",
      "name": "Note: draft",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2640,
        -40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.api_url }}/internal/v1/leads/{{ $('Verify event').first().json.lead_id }}/follow-up-draft",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}"
      },
      "id": "9ffbd879-a02e-54f7-b1ee-1eef98d09ee0",
      "name": "Create follow-up draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "leadApiToken0001",
          "name": "Lead API service token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Code node \"Plan <step> retry\" (run once for all items), placed after an HTTP Request node\n// that returns the full response and never throws on HTTP errors.\n//\n// Classifies the API's answer and decides what happens next:\n//   ok          2xx: continue with the step the API names in body.next\n//   retry       transient (connection error, 429, 5xx): wait, then call again\n//   exhausted   transient, but the attempts for this run are used up: stop this run with an\n//               error so the event is delivered again later (the dispatcher backs off)\n//   permanent   4xx: stop; an operator must act (nothing is retried automatically)\n//\n// The wait grows exponentially with full jitter and honours Retry-After, capped at 60 s.\nconst STEP = 'follow_up_draft';\nconst MAX_ATTEMPTS = 3;\nconst BASE_WAIT_S = 20;\n\nconst response = $json || {};\nconst status = Number(response.statusCode || 0);\nconst body = response.body && typeof response.body === 'object' ? response.body : {};\nconst attempt = $runIndex + 1;\n\nlet route;\nif (status >= 200 && status < 300) {\n  route = 'ok';\n} else if (status === 0 || status === 429 || status >= 500) {\n  route = attempt < MAX_ATTEMPTS ? 'retry' : 'exhausted';\n} else {\n  route = 'permanent';\n}\n\nlet waitS = 0;\nif (route === 'retry') {\n  const headers = response.headers || {};\n  const retryAfter = Number(headers['retry-after'] || 0);\n  const ceiling = Math.min(60, BASE_WAIT_S * 2 ** (attempt - 1));\n  const jittered = Math.max(1, Math.round(ceiling / 2 + Math.random() * (ceiling / 2)));\n  waitS = Math.min(60, Math.max(jittered, retryAfter));\n}\n\nconst error = body.error || {};\nreturn [\n  {\n    json: {\n      step: STEP,\n      route,\n      attempt,\n      status_code: status,\n      wait_s: waitS,\n      next: route === 'ok' ? String(body.next || 'stop') : 'stop',\n      lead_status: body.status || null,\n      detail: body.detail || {},\n      error: route === 'ok' ? null : String(error.code || (response.error && response.error.message) || `HTTP ${status}`).slice(0, 200),\n    },\n  },\n];\n"
      },
      "id": "b631c181-070d-579d-ac5c-43bf3e1074bc",
      "name": "Plan draft retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        200
      ]
    },
